{
  "name": "manos-mx",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:api": "tsx watch server/index.ts",
    "dev:all": "npm run db:setup && (npm run dev:api & npm run dev; trap 'kill 0' EXIT)",
    "start:api": "node dist-server/index.js",
    "build:api": "tsc -p tsconfig.server.json",
    "build": "tsc -b && vite build",
    "build:vercel": "node scripts/verify-vercel-static.mjs && npm run build",
    "typecheck": "tsc -b && tsc -p tsconfig.server.json --noEmit",
    "lint": "eslint .",
    "db:migrate": "tsx server/scripts/migrate.ts",
    "db:seed": "tsx server/scripts/seed.ts",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "test": "vitest run",
    "test:watch": "vitest",
    "security:secrets": "node scripts/scan-secrets.mjs",
    "verify:vercel": "node scripts/verify-vercel-static.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "express": "^4.22.1",
    "lucide-react": "0.453.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^4.17.25",
    "@types/node": "^22.19.18",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "6.0.4",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "0.4.26",
    "globals": "16.5.0",
    "tsx": "^4.23.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "brace-expansion@^1.1.7": "1.1.16",
    "brace-expansion@^5.0.5": "5.0.8"
  }
}
