# Local development. Demo auth is intentionally rejected in production unless explicitly enabled.
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3001
DATABASE_PATH=./data/manos-mx.db
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=info
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000
AUTH_MODE=demo
# Set only for an explicitly accepted demo deployment; replace demoIdentity middleware for real auth.
ALLOW_DEMO_AUTH_IN_PRODUCTION=false
